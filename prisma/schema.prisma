generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Strategy {
  id          String        @id @default(uuid())
  name        String
  description String?
  instrument  String        @default("BTC-PERP")
  timeframe   String        @default("1h")
  nodes       Json
  edges       Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  backtests      BacktestRun[]
  paperSessions  PaperSession[]
}

model BacktestRun {
  id         String   @id @default(uuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  mode       String   @default("backtest") // "backtest" | "paper"
  status     String   @default("queued")   // "queued" | "running" | "completed" | "failed"
  startTime  String?
  endTime    String?
  metrics    Json?
  log        Json?
  createdAt  DateTime @default(now())
  trades     Trade[]
}

model Trade {
  id          String      @id @default(uuid())
  runId       String
  run         BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  side        String      // "long" | "short"
  entryTime   String
  entryPrice  Float
  exitTime    String?
  exitPrice   Float?
  qty         Float
  pnl         Float       @default(0)
  reasonOpen  Json
  reasonClose Json?
  createdAt   DateTime    @default(now())
}

// ─── Paper Trading ───────────────────────────────────────────
model PaperSession {
  id                String       @id @default(uuid())
  strategyId        String
  strategy          Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  status            String       @default("idle") // "idle" | "running" | "stopped" | "error"
  instrument        String       @default("BTC-PERP")
  timeframe         String       @default("1h")
  lastPrice         Float        @default(100)
  equity            Float        @default(10000)
  realizedPnl       Float        @default(0)
  unrealizedPnl     Float        @default(0)
  positionSide      String?      // "long" | "short" | null
  positionQty       Float        @default(0)
  positionEntryPrice Float?
  positionOpenedAt  DateTime?    // when current position was opened (for trade entryTime on close)
  engineState       Json?        // serialized EngineState for shared engine
  useRealBars       Boolean      @default(false) // replay real TimescaleDB candles instead of synthetic
  barCursor         DateTime?    // pointer to last replayed candle's open_time
  startedAt         DateTime?
  updatedAt         DateTime     @updatedAt
  createdAt         DateTime     @default(now())
  trades            PaperTrade[]

  @@index([strategyId])
}

model PaperTrade {
  id         String       @id @default(uuid())
  sessionId  String
  session    PaperSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side       String       // "long" | "short"
  qty        Float
  entryTime  DateTime
  entryPrice Float
  exitTime   DateTime?
  exitPrice  Float?
  pnl        Float        @default(0)
  createdAt  DateTime     @default(now())

  @@index([sessionId, entryTime])
}

// ─── Market Data Ingestion ────────────────────────────────────
// Tracks historical backfill jobs. TimescaleDB candle data lives
// in the raw SQL schema (db/migrations/timescale/); this table
// just records job status so the API can expose progress.
model IngestionJob {
  id           String    @id @default(uuid())
  exchange     String                         // 'binance', 'bybit', …
  symbol       String                         // CCXT unified: 'BTC/USDT:USDT'
  timeframe    String                         // '1m', '1h', …
  dataType     String    @default("candle")   // 'candle' (phase 1); 'funding', 'oi' later
  startTime    DateTime
  endTime      DateTime
  status       String    @default("pending")  // 'pending'|'running'|'completed'|'failed'
  rowsInserted Int?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  meta         Json?                          // retry count, last cursor, etc.

  @@index([status])
  @@index([exchange, symbol, dataType, startTime])
}
